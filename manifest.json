{
  "manifest_version": 3,
  "name": "한국학 공구서",
  "version": "1.2",
  "description": "한국학 웹사전·동양연표·한자입력기를 사이드패널로 제공하며, 웹페이지에서 텍스트를 드래그하거나 우클릭하여 바로 조회할 수 있습니다.",
  "permissions": ["sidePanel", "contextMenus", "storage", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "한국학 공구서 열기"
  }
}
